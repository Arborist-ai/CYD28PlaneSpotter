#pragma once
// =======================================================================
// CYD28 Plane Spotter — Configuration
// =======================================================================
// Copy this file to config.env and fill in your values.
// This file is #include'd by main.cpp — keep it as valid C preprocessor!

#define WIFI_SSID "yourWifiId"
#define WIFI_PASS "yourPassword"

// Web config page credentials. An empty password disables the config server
// entirely — set one to enable it. Digest auth keeps the password off the
// wire, but the page itself is plain HTTP: keep the device on a network you
// trust.
#define CONFIG_AUTH_USER "admin"
#define CONFIG_AUTH_PASS ""

// OpenSky Network OAuth2 client credentials.
// Leave BOTH blank for anonymous access — it works, just with a lower rate
// limit. Create a client at https://opensky-network.org/my-opensky/account
#define OPENSKY_CLIENT_ID ""
#define OPENSKY_CLIENT_SECRET ""

#define TIMEZONE "CET-1CEST,M3.5.0,M10.5.0/3"
#define UPDATE_INTERVAL_MS 10000
#define WEATHER_INTERVAL_MS 600000

// Runtime-configurable location & radar (persisted via NVS)
// Defaults below; overridden by web UI and saved to flash.
#define DEFAULT_HOME_LAT      47.5774
#define DEFAULT_HOME_LON      8.5212
#define DEFAULT_SEARCH_RADIUS 1.0
#define DEFAULT_RADAR_MAX_KM  50.0f
